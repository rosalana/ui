{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "baseUrl": "..",
    "paths": {
      "@rosalana/ui": ["src/index.ts"],
      "@rosalana/ui/helpers": ["src/helpers/index.ts"],
      "workbench/*": ["workbench/*"]
    },
    "noEmit": true,
    "emitDeclarationOnly": false
  },
  "include": ["./**/*.ts", "./**/*.vue"]
}
