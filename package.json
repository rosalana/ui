{
  "name": "@rosalana/ui",
  "version": "0.0.1",
  "description": "Vue 3 UI library with shared theming, composables and components for Rosalana apps built on Inertia.js",
  "keywords": [
    "vue",
    "vue3",
    "inertia",
    "ui",
    "components",
    "tailwindcss",
    "reka-ui",
    "rosalana"
  ],
  "homepage": "https://github.com/rosalana/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosalana/ui.git"
  },
  "bugs": {
    "url": "https://github.com/rosalana/ui/issues"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./tailwind.css": "./src/tailwind.css",
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers.es.js",
      "require": "./dist/helpers.cjs.js"
    }
  },
  "files": [
    "dist",
    "src/tailwind.css",
    "src/document-content.css",
    "src/components"
  ],
  "scripts": {
    "workbench": "vite --config workbench/vite.config.ts",
    "dev:vite": "vite build --watch",
    "dev:tsc": "vue-tsc --declaration --emitDeclarationOnly --watch",
    "typecheck": "vue-tsc --noEmit",
    "dev": "npm run build -- --watch",
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "author": "michaelbany <mobany526@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@inertiajs/vue3": "^3.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue": "^3.5.20",
    "vue-tsc": "^2.0.21"
  },
  "peerDependencies": {
    "@inertiajs/vue3": "^2.1.0 || ^3.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/lucide": "^1.2.98",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify/vue": "^5.0.0",
    "@rosalana/sandbox": "^0.2.1",
    "@vueuse/core": "^14.1.0",
    "@vueuse/math": "^14.2.1",
    "autoprefixer": "^10.4.21",
    "axios": "^1.11.0",
    "motion-v": "^1.10.0",
    "reka-ui": "^2.7.0",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.0",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.8",
    "vue-advanced-cropper": "^2.8.9"
  }
}
